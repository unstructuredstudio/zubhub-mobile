# Firebase Configuration
# Copy this file to .env and fill in your real values
# Get these from: Firebase Console → Project Settings → Your Apps → Web app config

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Claude AI — for activity generation
EXPO_PUBLIC_CLAUDE_API_KEY=your-claude-api-key

# Where shared links point (share sheet, PDF footer). LEAVE UNSET until a real
# landing page or store listing exists: with no value the link is simply left
# out of the share message rather than pointing somewhere that 404s.
EXPO_PUBLIC_APP_BASE_URL=

# Suggest / ML server. Must be a public HTTPS host — the in-app Suggest button
# hides itself for localhost or LAN addresses, and Android blocks plain http.
EXPO_PUBLIC_SUGGEST_API_URL=
