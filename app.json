{
  "expo": {
    "name": "ZubHub",
    "slug": "zubhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.zubhub.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ZubHub needs access to your photos to upload activity images.",
        "NSCameraUsageDescription": "ZubHub needs camera access to take photos for your activities."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E53E3E"
      },
      "package": "org.zubhub.app",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ],
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E53E3E",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ZubHub needs access to your photos to upload activity images.",
          "cameraPermission": "ZubHub needs camera access to photograph what participants made."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "c6e153b5-cb67-47ed-8955-4ed23bcbe718"
      }
    },
    "owner": "srishakatux"
  }
}
