rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// ZubHub Firestore Security Rules
//
// Deploy with:  firebase deploy --only firestore:rules
// (first time:  npm i -g firebase-tools && firebase login && firebase use --add)
//
// Editing this file alone changes nothing: the rules are enforced from the
// deployed ruleset, so a new collection stays default-denied until you deploy.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Activities ────────────────────────────────────────────────────────────
    match /activities/{activityId} {
      // Anyone can read published activities; authors can read their own (incl. drafts)
      allow read: if resource.data.is_published == true
        || (request.auth != null && resource.data.created_by == request.auth.uid);

      // Only signed-in users can create, and they must set themselves as author
      allow create: if request.auth != null
        && request.resource.data.created_by == request.auth.uid;

      // Author can delete their own activities
      allow delete: if request.auth != null
        && resource.data.created_by == request.auth.uid;

      // Author can update anything; other signed-in users can only increment counters
      allow update: if request.auth != null
        && (resource.data.created_by == request.auth.uid
            || onlyCounterFieldsChanged());
    }

    // Helper: true when only engagement counters are changed
    function onlyCounterFieldsChanged() {
      let allowed = ['view_count', 'download_count', 'share_count',
                     'facilitation_count', 'remix_count',
                     'rating', 'rating_count'].toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ── User Profiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone can read profiles (for showing creator name on activities)
      allow read: if true;

      // Only the user themselves can write their profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Community Notes ───────────────────────────────────────────────────────
    match /community_notes/{noteId} {
      allow read: if true;

      // Signed-in users can add notes, must set their own user_id
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;

      // The note author can update or delete their own note. The owner of the
      // activity may also delete notes attached to it, so deleting an activity
      // does not leave other educators' notes stranded.
      allow update: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.user_id == request.auth.uid
            || ownsActivity(resource.data.activity_id));
    }

    // True when the signed-in user created the activity. Returns false once the
    // activity is gone, so attached documents must be cleared before it.
    function ownsActivity(activityId) {
      return activityId is string
        && exists(/databases/$(database)/documents/activities/$(activityId))
        && get(/databases/$(database)/documents/activities/$(activityId))
             .data.created_by == request.auth.uid;
    }

    // ── Facilitation Sessions (Runs) ──────────────────────────────────────────
    // One document per completed run of an activity. Runs are recorded whether
    // or not the educator writes a note, and they are what `facilitation_count`
    // is meant to reflect.
    match /facilitation_sessions/{sessionId} {
      // Readable by anyone: activity pages aggregate runs across educators.
      allow read: if true;

      // Signed-in users can record their own runs only.
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.activity_id is string
        && request.resource.data.student_count is number
        && request.resource.data.student_count >= 0;

      // A run is a historical fact — it may be removed by its owner, but not
      // rewritten, so the counter it fed cannot be retroactively changed.
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.user_id == request.auth.uid
            || ownsActivity(resource.data.activity_id));
    }

    // ── Activity Photos ───────────────────────────────────────────────────────
    // What participants made. Deliberately its own collection: photos are added
    // without writing anything, and deleting a written experience must not take
    // them with it.
    match /activity_photos/{photoId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.activity_id is string
        && request.resource.data.url is string;

      // A photo is a record of what happened, so it is removed rather than
      // edited. The uploader or the activity's owner may remove one.
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.user_id == request.auth.uid
            || ownsActivity(resource.data.activity_id));
    }

    // ── Push Tokens ───────────────────────────────────────────────────────────
    // Kept out of the user profile because profiles are world-readable and a
    // push token should not be. Any signed-in user can read one, because the
    // client that triggers an event is the one that sends the notification --
    // when a server exists, tighten this to deny client reads entirely.
    match /push_tokens/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Engagement Events (Analytics) ─────────────────────────────────────────
    match /engagement_events/{eventId} {
      // Signed-in users can read events (needed for notifications on own activities)
      allow read: if request.auth != null;

      // Anyone can create events (tracks anonymous views); validate shape
      allow create: if request.resource.data.keys().hasOnly(
          ['activity_id', 'user_id', 'event_type', 'platform', 'metadata', 'created_at'])
        && request.resource.data.event_type is string
        && request.resource.data.event_type.size() < 50;
    }
  }
}
